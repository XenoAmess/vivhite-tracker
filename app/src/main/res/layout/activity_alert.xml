<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_alert_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cvAlertIcon"
            android:layout_width="132dp"
            android:layout_height="132dp"
            app:cardCornerRadius="66dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivAlertIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="开播图标"
                android:scaleType="centerCrop"
                android:src="@drawable/img_on" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvAlertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="🎉 白绮开播啦！"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlertMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.35"
            android:text="直播间 11258892 正在直播中\n快去看看吧！"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToLive"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="32dp"
            android:text="立即前往直播间"
            android:textSize="17sp"
            app:backgroundTint="@color/green_500"
            app:cornerRadius="29dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="我知道了"
            android:textColor="@color/purple_500"
            android:textSize="16sp"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="26dp" />
    </LinearLayout>
</ScrollView>
