<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchMonitorVideos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="监控新视频投稿" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchMonitorPinned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="监控置顶视频变化" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchMonitorDynamics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="监控动态" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="动态类型（勾选的才提醒）"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbDynDraw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="图文动态" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbDynForward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="转发动态" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbDynArticle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="专栏" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAlertRingOnActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="新视频/动态时也响铃" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="（开播始终响铃，不受此控制）"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>