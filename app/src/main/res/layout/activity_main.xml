<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cvStatus"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="48dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_off"
                android:scaleType="centerCrop"
                android:contentDescription="状态图标" />

        </androidx.cardview.widget.CardView>

        <!-- 头部：头像居左，标题/状态/房间号/上次检测四行文字在右侧，
             packed 竖直链与头像垂直居中对齐（省约 150dp 高度） -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="牢白播了吗"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="textStart"
            android:textColor="@color/purple_500"
            app:layout_constraintBottom_toTopOf="@id/tvStatus"
            app:layout_constraintStart_toEndOf="@id/cvStatus"
            app:layout_constraintTop_toTopOf="@id/cvStatus"
            app:layout_constraintVertical_chainStyle="packed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:contentDescription="分享直播间"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/purple_500"
            app:strokeColor="@color/purple_500"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toEndOf="@id/tvTitle"
            app:layout_constraintTop_toTopOf="@id/tvTitle" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:text="监控状态: 已停止"
            android:textSize="17sp"
            android:textAlignment="textStart"
            android:textColor="@android:color/holo_red_dark"
            app:layout_constraintBottom_toTopOf="@id/tvRoomId"
            app:layout_constraintStart_toEndOf="@id/cvStatus"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <TextView
            android:id="@+id/tvRoomId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="直播间: 11258892"
            android:textSize="15sp"
            android:textAlignment="textStart"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintBottom_toBottomOf="@id/cvStatus"
            app:layout_constraintStart_toEndOf="@id/cvStatus"
            app:layout_constraintTop_toBottomOf="@id/tvStatus" />

        <!-- 上次检测单独整行：右侧列宽度被头像挤占，长文本显示不全（用户反馈） -->
        <TextView
            android:id="@+id/tvLastCheck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="上次检测: 暂无记录"
            android:textSize="14sp"
            android:textAlignment="textStart"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvStatus" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenLive"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="打开直播间"
            android:textSize="16sp"
            app:backgroundTint="@color/green_500"
            app:icon="@android:drawable/ic_menu_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLastCheck" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenSpace"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="打开空间主页"
            android:textSize="14sp"
            app:backgroundTint="@color/blue_500"
            app:icon="@android:drawable/ic_menu_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnOpenLive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="开始监控"
            android:textSize="16sp"
            app:backgroundTint="@color/green_500"
            app:icon="@android:drawable/ic_media_play"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnOpenSpace" />

        <!-- 魔法期记录行：主按钮 + 同行右侧分享小按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMagicRecord"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="魔法期记录"
            android:textSize="14sp"
            app:backgroundTint="@color/purple_500"
            app:icon="@android:drawable/ic_menu_month"
            app:layout_constraintEnd_toStartOf="@id/btnMagicShare"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnToggle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMagicShare"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:contentDescription="生成并分享魔法期图片"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:backgroundTint="@color/purple_500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnMagicRecord"
            app:layout_constraintTop_toBottomOf="@id/btnToggle" />

        <!-- 三个非监控入口并排：日志 | 设置 | 源码 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewLog"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="日志"
            android:textSize="14sp"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconSize="14dp"
            app:iconPadding="4dp"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnStats"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="设置"
            android:textSize="14sp"
            app:icon="@android:drawable/ic_menu_manage"
            app:iconSize="14dp"
            app:iconPadding="4dp"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toStartOf="@id/btnOpenGithub"
            app:layout_constraintStart_toEndOf="@id/btnViewLog"
            app:layout_constraintTop_toBottomOf="@id/btnStats" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenGithub"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="源码"
            android:textSize="14sp"
            app:icon="@android:drawable/ic_menu_share"
            app:iconSize="14dp"
            app:iconPadding="4dp"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnSettings"
            app:layout_constraintTop_toBottomOf="@id/btnStats" />

        <!-- 场次记录：独立整行（与开始/停止监控同款 icon 间距与排版），位于 日志/设置/源码 上方 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStats"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="场次记录"
            android:textSize="16sp"
            app:backgroundTint="@color/blue_500"
            app:icon="@android:drawable/ic_menu_agenda"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnMagicRecord" />

        <LinearLayout
            android:id="@+id/qqGroupRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnViewLog" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="• 每分钟检查直播状态 • 开播响铃+震动+屏幕提醒\n• 后台运行需关闭电池优化 • 通知栏显示直播状态"
            android:textColor="@android:color/darker_gray"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/qqGroupRow" />

        <TextView
            android:id="@+id/tvQuote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintBottom_toTopOf="@id/versionRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            tools:text="「数学是科学的皇后。」—— 高斯" />

        <LinearLayout
            android:id="@+id/versionRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuote">

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                tools:text="v1.0.61 (a1b2c3d4)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckUpdate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="检查更新"
                android:textSize="11sp"
                android:textColor="@color/purple_500"
                app:strokeColor="@color/purple_500" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBetaUpdate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="内测版尝鲜"
                android:textSize="11sp"
                android:textColor="@color/purple_500"
                app:strokeColor="@color/purple_500" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
