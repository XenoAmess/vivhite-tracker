<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMoodEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="20:30 😄开心 · 看了场直播" />

        <TextView
            android:id="@+id/tvMoodEventReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="13sp"
            android:text="原因：她唱了我点的歌" />

        <TextView
            android:id="@+id/tvMoodEventNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:text="备注：下次还要点" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMoodEventDelete"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="删除心情事件"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconSize="18dp"
        app:iconTint="@android:color/darker_gray" />

</LinearLayout>
